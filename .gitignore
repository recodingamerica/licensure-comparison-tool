# Frontend data is fetched from Vercel Blob at build time, not committed
pipeline/publish/web/public/data/
pipeline/publish/web/public/professions.json
pipeline/publish/web/public/states.json

# State-getting pipeline LLM outputs (regenerable; consumed by match_profession at runtime)
pipeline/results/section_bodies/
pipeline/results/section_maps/
pipeline/results/chapter_maps/

# Development screenshots — captured during sessions, not part of the build
*.png
!pipeline/publish/web/public/**/*.png
.vercel
pipeline/results/.refresh_manifest.json
pipeline/results/.upload_manifest.json

# CDP grind scratch (ephemeral; _cdp_grind.py itself is tracked as tooling)
pipeline/results/batches/*.log
pipeline/results/batches/_grind_launcher.sh
pipeline/results/batches/_teeup_new_trades.sh
pipeline/results/batches/_umbrella_inject.json
# evicted from batches/ → queues/ (scratch worklists; _downstream_queue.json is tracked)
pipeline/results/queues/_new_trades_queue.json
pipeline/results/queues/_repull_candidates.json
pipeline/results/queues/_umbrella_candidates.json
.scratch/
pipeline/results/.run_log.json

